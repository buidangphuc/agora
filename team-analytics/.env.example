# Copy to .env and fill in. .env is gitignored. `make check-env` fails if this
# drifts from the fields declared in internal/config (both directions).

# ── Runtime ─────────────────────────────────────────────────────────────────
ENV=local
LOG_LEVEL=info
LOG_JSON=true

# ── gRPC health server (probes only; this worker serves NO business RPC) ─────
GRPC_HOST=0.0.0.0
GRPC_PORT=50059
GRPC_REFLECTION_ENABLED=true
SHUTDOWN_GRACE_SECONDS=10

# ── Kafka consumer (ADR-0002): consume analytics.events ─────────────────────
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=team-analytics
KAFKA_ANALYTICS_TOPIC=analytics.events

# ── Warehouse (WarehouseWriter seam) ────────────────────────────────────────
# WAREHOUSE_DRIVER selects the adapter: duckdb (local/test, columnar Parquet) or
# bigquery (prod). The consume/unmarshal path is identical for both.
WAREHOUSE_DRIVER=duckdb
# DuckDB adapter (local/test):
DUCKDB_PATH=/data/analytics.duckdb
# BigQuery adapter (prod; not exercised in local e2e — unit/parity-tested only):
BIGQUERY_PROJECT=
BIGQUERY_DATASET=analytics
BIGQUERY_TABLE=tracking_events

# ── Batching (~100 evts/s target; flush on size OR interval) ─────────────────
BATCH_MAX_SIZE=500
BATCH_FLUSH_INTERVAL_SECONDS=2

# ── OpenTelemetry (ADR-0004; exporter swappable) ────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=team-analytics
