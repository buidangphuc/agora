# Copy to .env and fill in. .env is gitignored. `make check-env` fails if this
# drifts from the fields declared in internal/config (both directions).

# ── Runtime ─────────────────────────────────────────────────────────────────
ENV=local
LOG_LEVEL=info
LOG_JSON=true

# ── gRPC health server (probes only; this worker serves NO business RPC) ─────
GRPC_HOST=0.0.0.0
GRPC_PORT=50059
GRPC_REFLECTION_ENABLED=true
SHUTDOWN_GRACE_SECONDS=10

# ── Kafka consumer (ADR-0002): consume analytics.events ─────────────────────
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=team-analytics
KAFKA_ANALYTICS_TOPIC=analytics.events
KAFKA_ORDER_TOPIC=order.events
# listing.events -> listing_sellers mapping (own group, earliest offset) so seller
# funnels can attribute tracking events to a seller.
KAFKA_LISTING_TOPIC=listing.events
KAFKA_LISTING_CONSUMER_GROUP=team-analytics-listing-attrs

# ── Engagement facts (engagement.events -> engagement_facts; DuckDB only) ────
# Own consumer group. An undecodable or unknown-type record is republished to the
# DLQ topic and the consumer commits past it.
ENGAGEMENT_EVENTS_TOPIC=engagement.events
ENGAGEMENT_DLQ_TOPIC=engagement.events.analytics.dlq
ENGAGEMENT_CONSUMER_GROUP=team-analytics.engagement

# ── Warehouse (WarehouseWriter seam) ────────────────────────────────────────
# WAREHOUSE_DRIVER selects the adapter: duckdb (local/test, columnar Parquet) or
# bigquery (prod). The consume/unmarshal path is identical for both.
WAREHOUSE_DRIVER=duckdb
# DuckDB adapter (local/test):
DUCKDB_PATH=/data/analytics.duckdb
# BigQuery adapter (prod; not exercised in local e2e — unit/parity-tested only):
BIGQUERY_PROJECT=
BIGQUERY_DATASET=analytics
BIGQUERY_TABLE=tracking_events
# Offline-training export (DuckDB only): tracking_events → Parquet for
# platform-recsys, atomically replaced every N seconds; 0 disables it.
PARQUET_EXPORT_PATH=
PARQUET_EXPORT_INTERVAL_SECONDS=0

# ── Batching (~100 evts/s target; flush on size OR interval) ─────────────────
BATCH_MAX_SIZE=500
BATCH_FLUSH_INTERVAL_SECONDS=2

# ── Tracking data quality (GetTrackingQualityReport status thresholds) ──────
# DEGRADED(stale) when the latest ingest is older than this many seconds.
TRACKING_STALE_AFTER_SECONDS=900
# DEGRADED(lagging) when the p95 ingest lag (ingested_at - occurred_at) exceeds it.
TRACKING_LAG_P95_MAX_SECONDS=300
# DEGRADED(incomplete) when a listing-scoped type's share of events without a
# listing_id exceeds it (0 to 1).
TRACKING_MISSING_LISTING_MAX_RATIO=0.05

# ── Recommendation online evaluation (GetRecommendationPerformance) ─────────
# Hours after a click during which an add-to-cart or purchase is credited to it.
RECS_ATTRIBUTION_WINDOW_HOURS=24

# ── OpenTelemetry (ADR-0004; exporter swappable) ────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=team-analytics
