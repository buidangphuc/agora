# Copy to `.env` and adjust. `.env` is gitignored; never commit real secrets.

# gRPC listen port (Server.kt default = 50053).
GRPC_PORT=50053

# DB-per-service: this service owns listing_db and touches no other DB.
DATABASE_URL=postgresql://listing_svc:listing_pass@localhost:5433/listing_db

# Static bearer credential for the seed AuthInterceptor (ADR-0003).
# Any non-blank value authenticates in the seed; replace with JWT/cookie later.
AUTH_BEARER_TOKEN=

# OpenTelemetry (ADR-0004) — exporter-swappable, OFF by default in `make dev`.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=team-service
