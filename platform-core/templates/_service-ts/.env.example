# Edge (BFF) configuration. Copy to .env and adjust. .env is gitignored.

# Base URL of the platform Gateway this edge calls over gRPC (Rule 1: the edge
# talks only to the Gateway, never directly to backend services).
GATEWAY_URL=http://localhost:8080

# Port the thin HTTP/BFF surface listens on.
PORT=3000

# Static bearer token for the edge → Gateway hop (ADR-0003). Leave blank in
# local dev if the Gateway allows anonymous.
AUTH_BEARER_TOKEN=

# OpenTelemetry (ADR-0004). Local collector default; leave blank to disable export.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=team-frontend-edge
