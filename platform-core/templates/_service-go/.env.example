# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# gRPC listen port.
GRPC_PORT=50051

# DB-per-service: ONLY this service connects to this database (ADR / arch rule).
# Other services reach this data over gRPC, never by sharing the DB.
DATABASE_URL=postgresql://listing_svc:listing_pass@localhost:5433/listing_db

# Optional cache.
REDIS_URL=redis://localhost:6379

# Stub shared secret for the bearer auth interceptor (ADR-0003).
# Empty => all calls are rejected as unauthenticated. Set a value to allow.
AUTH_BEARER_TOKEN=

# OpenTelemetry (ADR-0004). Exporter is OTLP/gRPC; endpoint is a collector.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=team-service
