# Copy to `.env` and adjust. Keys mirror src/config.py:Settings exactly —
# an unknown key here is a hard error (extra="forbid").

# ── Transport ────────────────────────────────────────────────────────────────
GRPC_PORT=50052

# ── Datastores (this service owns its own storage) ───────────────────────────
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/team_service
QDRANT_URL=http://localhost:6333
# REDIS_URL=redis://localhost:6379/0

# ── Auth (static bearer token stub; TODO JWT/cookie per ADR-0003) ────────────
# AUTH_BEARER_TOKEN=change-me-to-a-long-random-token

# ── Observability (OTel) ─────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=team-service
