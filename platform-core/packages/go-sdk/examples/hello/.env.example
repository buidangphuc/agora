# Runtime
ENV=local
LOG_LEVEL=info
LOG_JSON=false

# gRPC
GRPC_HOST=0.0.0.0
GRPC_PORT=9090
GRPC_REFLECTION_ENABLED=false
SHUTDOWN_GRACE=10s
SHUTDOWN_DRAIN_DELAY=0s

# Postgres (DATABASE_URL is required)
DATABASE_URL=postgres://hello:hello@localhost:5432/hello?sslmode=disable
DB_MAX_CONNS=10

# OpenTelemetry
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
