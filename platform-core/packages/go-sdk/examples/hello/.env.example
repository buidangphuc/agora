# Runtime
ENV=local
LOG_LEVEL=info
LOG_JSON=false

# gRPC
GRPC_HOST=0.0.0.0
GRPC_PORT=9090
# Off: hello's hand-built ServiceDesc has no descriptor. Turn on for generated services.
GRPC_REFLECTION_ENABLED=false
SHUTDOWN_GRACE_SECONDS=10
SHUTDOWN_DRAIN_DELAY_SECONDS=0

# Postgres (DATABASE_ENABLED=false skips it; when true, DATABASE_URL is required)
DATABASE_ENABLED=false
DATABASE_URL=
DB_MAX_CONNS=10

# OpenTelemetry
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
