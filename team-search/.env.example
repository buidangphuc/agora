# Copy to .env and fill in. .env is gitignored. `make check-env` fails if this
# drifts from the fields declared in internal/config (both directions).

# ── Runtime ─────────────────────────────────────────────────────────────────
ENV=local
LOG_LEVEL=info
LOG_JSON=true

# ── gRPC query API (SearchService) ──────────────────────────────────────────
GRPC_HOST=0.0.0.0
GRPC_PORT=50052
GRPC_REFLECTION_ENABLED=true
SHUTDOWN_GRACE_SECONDS=10

# ── OpenSearch read-model (ADR-0005; this service OWNS this index) ───────────
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=listings

# ── Retrieval platform (ADR-0005, ADR-0011) ─────────────────────────────────
MODEL_SERVER_URL=http://localhost:8100
EMBEDDING_DIM=384
ENABLE_HYBRID_SEARCH=true
ENABLE_RERANKER=false
HYBRID_FUSION_WINDOW=200
HYBRID_RRF_K=60
HYBRID_LEXICAL_WEIGHT=1.0
HYBRID_SEMANTIC_WEIGHT=1.0

# ── Tag classifier (add-tag-classifier-filter-enrichment) ───────────────────
# team-ai REST base URL the INDEXER calls to classify SPU tags + per-variant attributes
# for dynamic facets. Empty = no classification (listings are indexed without tags).
TAG_CLASSIFIER_URL=

# ── Kafka consumer (ADR-0002): index listing.events into OpenSearch ─────────
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=team-search-indexer
KAFKA_LISTING_TOPIC=listing.events

# ── Tombstones (indexer only): deleted listings keep a versioned tombstone so a
# late or redelivered older event cannot resurrect them; the indexer purges
# tombstones older than TOMBSTONE_TTL (measured from when it applied the delete)
# every TOMBSTONE_PURGE_INTERVAL. Go durations; an invalid value falls back to the
# default with a WARN. An event older than a purged tombstone can resurrect it.
TOMBSTONE_TTL=336h
TOMBSTONE_PURGE_INTERVAL=1h

# ── Postgres: saved searches (migrations/0001_saved_searches) ───────────────
# false = in-memory fallback (saved searches are lost on restart); local/test only:
# with ENV=staging|stage|prod|production the server refuses to boot unless true.
# Migrations are NOT applied by this service: run golang-migrate against DATABASE_URL.
DATABASE_ENABLED=false
DATABASE_URL=postgres://search_svc:search_pass@localhost:5432/search_db?sslmode=disable

# Auth: no local secret. Per ADR-0003 the Gateway verifies the JWT at the edge
# and forwards a resolved Principal (x-principal-*); this service just reads it.

# ── OpenTelemetry (ADR-0004; exporter swappable) ────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=team-search
