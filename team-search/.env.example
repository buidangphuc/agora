# Copy to .env and fill in. .env is gitignored. `make check-env` fails if this
# drifts from the fields declared in internal/config (both directions).

# ── Runtime ─────────────────────────────────────────────────────────────────
ENV=local
LOG_LEVEL=info
LOG_JSON=true

# ── gRPC query API (SearchService) ──────────────────────────────────────────
GRPC_HOST=0.0.0.0
GRPC_PORT=50052
GRPC_REFLECTION_ENABLED=true
SHUTDOWN_GRACE_SECONDS=10

# ── OpenSearch read-model (ADR-0005; this service OWNS this index) ───────────
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=listings

# ── Kafka consumer (ADR-0002): index listing.events into OpenSearch ─────────
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=team-search-indexer
KAFKA_LISTING_TOPIC=listing.events

# Auth: no local secret. Per ADR-0003 the Gateway verifies the JWT at the edge
# and forwards a resolved Principal (x-principal-*); this service just reads it.

# ── OpenTelemetry (ADR-0004; exporter swappable) ────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=team-search
