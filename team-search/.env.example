ENV=local
LOG_LEVEL=info
LOG_JSON=true

GRPC_HOST=0.0.0.0
GRPC_PORT=50052
GRPC_REFLECTION_ENABLED=false
SHUTDOWN_GRACE=10s
SHUTDOWN_DRAIN_DELAY=0s

DATABASE_URL=postgres://search_svc:search_pass@localhost:5432/search_db?sslmode=disable
DB_MAX_CONNS=10

OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=listings

MODEL_SERVER_URL=http://localhost:8100
EMBEDDING_DIM=384
ENABLE_HYBRID_SEARCH=true
ENABLE_RERANKER=false
HYBRID_FUSION_WINDOW=200
HYBRID_RRF_K=60
HYBRID_LEXICAL_WEIGHT=1.0
HYBRID_SEMANTIC_WEIGHT=1.0
HYBRID_SEMANTIC_MIN_SCORE=0.65

UPSTREAM_AI_ADDR=localhost:50051

KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=team-search-indexer
KAFKA_LISTING_TOPIC=listing.events
LOG_KEY_FP_SECRET=local-dev-log-key-fp-secret

TOMBSTONE_TTL=336h
TOMBSTONE_PURGE_INTERVAL=1h

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=team-search
