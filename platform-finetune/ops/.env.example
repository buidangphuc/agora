# Fine-tuning job settings against the agora local stack (docker-compose.services.yaml, profile "jobs").
# The compose service sets these itself; export them to run `python main.py run` on the host.
MLFLOW_TRACKING_URI=http://localhost:5050
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
