# Copy to .env and fill in. .env is gitignored. `make check-env` fails if this
# drifts from the fields declared in recsys/config.py (_FIELDS), both directions.

# ── Runtime ──────────────────────────────────────────────────────────────────
ENV=local
LOG_LEVEL=info

# ── Spark ────────────────────────────────────────────────────────────────────
# Local dev / CI run in-process local mode; a real spark-submit overrides these.
SPARK_MASTER=local[*]
SPARK_APP_NAME=platform-recsys-als

# ── Governed training dataset (written by platform-featurestore) ─────────────
# The ALS job reads ONLY this, never raw tracking events. DATASET_PATH (an explicit
# as_of=<stamp>.parquet file, manifest beside it) overrides DATASET_DIR (the latest
# as_of=*.parquet snapshot is used). With neither, the job exits 2 naming DATASET_DIR.
DATASET_DIR=/features/datasets/als_interactions/v1
DATASET_PATH=

# ── Interactions (dataset pairs → ALS input; the weight is used as given) ────
MIN_INTERACTIONS_PER_USER=1
MIN_INTERACTIONS_PER_ITEM=1

# ── ALS hyperparameters (Spark MLlib, implicitPrefs=true) ────────────────────
ALS_RANK=64
ALS_REG_PARAM=0.05
ALS_ALPHA=40.0
ALS_MAX_ITER=15

# ── Outputs ──────────────────────────────────────────────────────────────────
TOP_N=50

# Qdrant (:6333 — the instance team-ai targets via RAG_QDRANT_URL).
# QDRANT_ITEM_COLLECTION MUST equal the consumer's RECS_QDRANT_COLLECTION default.
QDRANT_URL=http://localhost:6333
QDRANT_ITEM_COLLECTION=item_als_vectors
QDRANT_USER_COLLECTION=user_als_vectors

# Redis (:6379) precomputed Top-N cache.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Cache key schema — MUST match the consumer (serve-recommendations-teamai):
# `recs:v1:user:{id}`, `recs:v1:item:{id}`, `recs:v1:popular`, `recs:v1:model_version`.
RECS_CACHE_PREFIX=recs
RECS_SCHEMA_VERSION=v1
RECS_CACHE_TTL_SECONDS=172800

# ── Two-Tower candidate retrieval stage (optional) ───────────────────────────
ENABLE_TWO_TOWER=false
QDRANT_TWO_TOWER_COLLECTION=item_two_tower_vectors
TWO_TOWER_DIM=32
# Governed featurestore snapshots the stage trains on (never invented features). *_PATH, an
# explicit file, wins over the latest as_of=*.parquet under *_DIR; with none the run exits 2.
ITEM_FEATURES_DIR=/features/item_popularity/v1
ITEM_FEATURES_PATH=
USER_FEATURES_DIR=/features/user_activity/v2
USER_FEATURES_PATH=
# item_attributes@v1 (category, price) and user_preferences@v1 (preferred categories) snapshots. Optional unless
# TWO_TOWER_REQUIRE_ATTRIBUTES=true (then a missing item_attributes snapshot exits 2).
ITEM_ATTRIBUTES_DIR=/features/item_attributes/v1
ITEM_ATTRIBUTES_PATH=
USER_PREFERENCES_DIR=/features/user_preferences/v1
USER_PREFERENCES_PATH=
TWO_TOWER_REQUIRE_ATTRIBUTES=false
# Category vocabulary of the towers: the most frequent categories of the item_attributes snapshot.
TWO_TOWER_MAX_CATEGORIES=64
# In-batch softmax training on the dataset's pairs (sampled to TWO_TOWER_MAX_PAIRS).
TWO_TOWER_EPOCHS=5
TWO_TOWER_LR=0.05
TWO_TOWER_BATCH_SIZE=256
TWO_TOWER_TEMPERATURE=0.1
TWO_TOWER_MAX_PAIRS=200000

# ── Nearline signal consumer (python -m recsys.nearline) ─────────────────────
# Long-running consumer of analytics.events that keeps the recs:nearline:* Redis keys fresh.
KAFKA_BROKERS=localhost:19092
KAFKA_ANALYTICS_TOPIC=analytics.events
NEARLINE_CONSUMER_GROUP=platform-recsys-nearline
# Where a group with no committed offset starts: latest (production) or earliest.
NEARLINE_START_OFFSET=latest
# Lifetime of every nearline key, and the age past which an event is ignored (24 h window).
NEARLINE_TTL_SECONDS=86400
# 0 = run until stopped; >0 = exit 0 after this many seconds without a message (drain mode, e2e).
NEARLINE_IDLE_EXIT_SECONDS=0

# ── Drift monitoring (each run vs the generation it replaces; never blocks a run) ──
# A feature whose PSI reaches this is flagged (0.1 moderate, 0.25 significant by convention).
DRIFT_ALERT_THRESHOLD=0.25
# Optional: write the run's Prometheus text metrics here (node-exporter textfile collector).
DRIFT_METRICS_PATH=

# ── Model Registry & Promotion Gate ──────────────────────────────────────────
PROMOTION_PRIMARY_METRIC=ndcg@10
PROMOTION_MIN_RELATIVE_IMPROVEMENT=0.01
PROMOTION_MIN_COVERAGE_RATIO=0.8
# Operator override: publish this run even if the gate rejects it (e.g. to
# repopulate Qdrant/Redis after a reset). Never set it on a schedule.
PROMOTION_FORCE=false

# ── Structural gate (runs before the metric gate; recsys-generations) ────────
# A candidate is rejected (status rejected, reason in metrics.gate_reason) when the share of
# dataset users with a list is below GATE_MIN_USER_COVERAGE, the share of dataset items in any
# top-N list is below GATE_MIN_ITEM_COVERAGE, the mean pairwise Jaccard overlap of users'
# top-N lists is above GATE_MAX_LIST_OVERLAP, or any factor is NaN/infinite.
GATE_MIN_USER_COVERAGE=0.5
GATE_MIN_ITEM_COVERAGE=0.05
GATE_MAX_LIST_OVERLAP=0.9

# Compatibility shim (one release): also write the unscoped recs:v1:{user,item,popular}
# keys next to the generation-scoped ones, so reverting team-ai keeps serving. true|false.
RECS_WRITE_LEGACY_KEYS=true

# Provenance stamped on every artifact; empty ⇒ derived from the run clock.
MODEL_VERSION=
