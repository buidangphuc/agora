# team-sharing environment configuration
# ENV is required: local, test, staging or prod. Only local and test allow the
# in-memory fallback.
ENV=local
LOG_LEVEL=info
LOG_JSON=true

GRPC_HOST=0.0.0.0
GRPC_PORT=50065
SHUTDOWN_GRACE=10s
SHUTDOWN_DRAIN_DELAY=0s

# DATABASE_URL is required. Outside ENV=local an unreachable database fails
# boot; in ENV=local the service falls back to an in-memory store.
DATABASE_URL=postgres://sharing_svc:sharing_pass@localhost:5447/sharing_db?sslmode=disable
DB_MAX_CONNS=10

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=team-sharing
