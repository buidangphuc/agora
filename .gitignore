**/src/generated/
**/app/transport/grpc/_pb/
**/gen/

# ── Node / Next.js (team-frontend) ──
**/node_modules/
**/.next/
**/out/
**/dist/
**/build/
*.tsbuildinfo

# ── Go build output ──
**/bin/
**/*.test
**/*.out

# ── Python ──
**/__pycache__/
**/*.py[cod]
**/.venv/
**/.pytest_cache/
**/.ruff_cache/
**/*.egg-info/

# ── Data / local warehouses / DBs ──
**/*.duckdb
**/*.duckdb.wal
**/*.sqlite
**/data/

# ── Test artifacts ──
**/test-results/
**/test-results/screenshots/
**/playwright-report/
