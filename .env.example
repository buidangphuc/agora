# Root compose (docker-compose.services.yaml) variables. Copy to `.env` (git-ignored) to override;
# every value has a local-only default in the compose file, so the stack also starts without it.
# Never commit a real secret here.

# team-ai has no database of its own in the local stack (DATABASE_ENABLED=false); these satisfy the
# required settings only. Do NOT point them at another service's database.
TEAM_AI_POSTGRES_USER=team_ai_svc
TEAM_AI_POSTGRES_PASSWORD=team-ai-local-placeholder # pragma: allowlist secret
TEAM_AI_POSTGRES_DB=team_ai_db

