# Root compose (docker-compose.services.yaml) variables. Copy to `.env` (git-ignored) to override;
# every value has a local-only default in the compose file, so the stack also starts without it.
# Never commit a real secret here.

# team-ai internal tag routes (tag-routes-authz). team-ai stores only sha256 hashes of API tokens:
# AUTH_API_KEYS is a comma-separated list of `subject:scope|scope:sha256hex`. Leave this unset to use the
# compose default, the hashes of the local tokens `agora-local-team-ai-service` (scope ai.classify) and
# `agora-local-team-ai-admin` (scope admin|ai.classify); the platform-e2e defaults match them.
# To use other tokens, generate each with `cd team-ai && uv run python -m scripts.hash_api_key --generate`,
# export the same raw tokens as TEAM_AI_SERVICE_TOKEN / TEAM_AI_ADMIN_TOKEN for the e2e run, and set:
# TEAM_AI_AUTH_API_KEYS=team-ai-service:ai.classify:<sha256 of service token>,team-ai-admin:admin|ai.classify:<sha256 of admin token>
# Production values come from Vault.
# TEAM_AI_AUTH_API_KEYS=
# e2e client side (platform-e2e): the raw tokens matching the hashes above.
TEAM_AI_SERVICE_TOKEN=agora-local-team-ai-service # pragma: allowlist secret
TEAM_AI_ADMIN_TOKEN=agora-local-team-ai-admin # pragma: allowlist secret

# Host port of team-ai HTTP (default 8001). The e2e tag-route tests reach it via TEAM_AI_URL.
TEAM_AI_HOST_PORT=8001
