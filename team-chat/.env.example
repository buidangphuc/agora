# team-chat environment configuration
ENV=local
LOG_LEVEL=info
LOG_JSON=true

GRPC_HOST=0.0.0.0
GRPC_PORT=50057
SHUTDOWN_GRACE_SECONDS=10
SHUTDOWN_DRAIN_DELAY_SECONDS=0

# DATABASE_URL is required and the database must be reachable at boot in every
# ENV: there is no in-memory fallback.
DATABASE_URL=postgres://chat_svc:chat_pass@localhost:5432/chat_db?sslmode=disable
DB_MAX_CONNS=10

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
OTEL_SERVICE_NAME=team-chat

# chat.events producer (ChatMessage with recipient_id); always on
KAFKA_BROKERS=localhost:19092
KAFKA_CHAT_TOPIC=chat.events

# chat.events outbox relayer (rows are written in the message transaction; the
# relayer publishes them to KAFKA_CHAT_TOPIC). Same names as team-order.
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100
OUTBOX_CLAIM_LOCK_SECONDS=60
OUTBOX_MAX_ATTEMPTS=10

# team-domain gRPC address (listing lookups)
UPSTREAM_LISTING_ADDR=localhost:50051
