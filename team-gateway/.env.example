# Copy to .env and fill in. .env is gitignored. `make check-env` fails if this
# drifts from the fields declared in internal/config.

# ── Runtime ─────────────────────────────────────────────────────────────────
ENV=local
LOG_LEVEL=info
LOG_JSON=true

# ── Edge HTTP listener (Connect: gRPC + gRPC-web + JSON) ─────────────────────
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
SHUTDOWN_GRACE_SECONDS=10

# ── Upstream routing table (gRPC services the gateway calls) ─────────────────
UPSTREAM_SEARCH_ADDR=localhost:50052
UPSTREAM_LISTING_ADDR=localhost:50051
UPSTREAM_IDENTITY_ADDR=localhost:50053
UPSTREAM_ENGAGEMENT_ADDR=localhost:50054
UPSTREAM_ORDER_ADDR=localhost:50055
UPSTREAM_PAYMENT_ADDR=localhost:50056
UPSTREAM_CHAT_ADDR=localhost:50057
UPSTREAM_AI_ADDR=localhost:50060
UPSTREAM_RECOMMENDATION_ADDR=localhost:50060
UPSTREAM_PROMOTION_ADDR=localhost:50061
UPSTREAM_NOTIFICATION_ADDR=localhost:50058
UPSTREAM_ANALYTICS_ADDR=team-analytics-svc:50059
UPSTREAM_REFERRAL_ADDR=team-referral-svc:50062
UPSTREAM_VERIFICATION_ADDR=team-verification-svc:50064
UPSTREAM_SHARING_ADDR=team-sharing-svc:50065
UPSTREAM_AUDIT_ADDR=team-audit-svc:50066
# Upper bound of the upstream reconnect backoff (and min connect timeout), so a
# recreated upstream is reachable again within seconds.
DIAL_TIMEOUT_SECONDS=2

# ── Edge auth (ADR-0006): verify RS256 JWT here, resolve Principal, forward it ─
# The gateway holds NO signing secret. It verifies the RS256 tokens team-identity
# signs against the public keys it fetches from identity's JWKS and caches for
# JWKS_CACHE_TTL seconds (refreshed on TTL and on an unknown kid). Anonymous
# callers (no token) get PUBLIC_SCOPES so browse/search stay open; a token that
# is present but invalid/expired is rejected with 401, never downgraded.
JWKS_URL=http://localhost:50063/.well-known/jwks.json
JWKS_CACHE_TTL=300
PUBLIC_SCOPES=listing.read,search:read

# ── Edge hardening ──────────────────────────────────────────────────────────
# Per-principal (or per-IP for anonymous) token-bucket rate limit.
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
# Deadline per upstream call; idempotent reads retry up to RETRY_MAX on Unavailable.
CALL_TIMEOUT_SECONDS=5
RETRY_MAX=2
# Collector (POST /api/track) bucket per visitor (user id, else client IP);
# separate from the RPC bucket above because beacons are bursty.
TRACK_RATE_LIMIT_RPS=5
TRACK_RATE_LIMIT_BURST=20
# AI generation RPCs (MagicListing, ChatCopilot, SummarizeReviews,
# ShoppingAssistant): one attempt, this deadline, no retry.
AI_CALL_TIMEOUT_SECONDS=30
# Max bytes of one StreamChat request message (larger -> resource_exhausted).
STREAM_MAX_REQUEST_BYTES=16384
# gRPC reflection. Development only: the gateway refuses to start with this true
# when ENV is staging or production.
EDGE_REFLECTION_ENABLED=false
# Browsers allowed to call the gateway directly (comma-separated).
CORS_ORIGINS=http://localhost:3000
# Prometheus base URL for the Admin Cockpit HUD (GET /api/admin/metrics runs a
# fixed server-side PromQL set here). Read-only; never exposed to the browser.
# Empty or unreachable → the handler returns zeroed values, never random data.
PROMETHEUS_URL=http://prometheus:9090
# Jaeger query API for the cockpit's recent traces (fixed query: service
# team-gateway, last 1h, limit 5; 2 s timeout). Server-side only. Empty or
# unreachable → recent_traces is empty. JAEGER_UI_URL is the browser-facing base
# used to build each trace's link.
JAEGER_QUERY_URL=http://jaeger:16686
JAEGER_UI_URL=http://localhost:16686

# Peers whose X-Forwarded-For the edge believes when computing the client IP it
# forwards to services as x-client-ip (audit only): comma-separated CIDRs, bare IPs
# or hostnames (re-resolved every 30s, e.g. the frontend service name). Empty trusts
# nobody: x-client-ip is the socket peer address. Never list an untrusted network.
TRUSTED_PROXIES=

# ── Edge telemetry producer (ADR-0002): browsing beacons → analytics.events ──
# The collector (POST /api/track) wraps a beacon in an EventEnvelope and produces
# a TrackingEvent. When KAFKA_ENABLED=false the producer is a no-op (beacons are
# still accepted, nothing is emitted) so browsing never depends on a broker.
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_ANALYTICS_TOPIC=analytics.events

# ── Session revocation (ADR-0003 addendum): identity.events → in-memory denylist ─
# The gateway consumes SessionRevoked from this topic (reusing KAFKA_ENABLED /
# KAFKA_BROKERS above) into a denylist of revoked session ids and answers 401 for a
# token whose `sid` is denylisted. No consumer group: every replica reads every
# partition from the earliest offset, so a restart rebuilds the list. Kafka down =>
# the gateway still starts and revocations are not enforced (fail open, logged;
# gauge gateway_revocation_consumer_up == 0). Retention must be >= the token TTL.
IDENTITY_EVENTS_TOPIC=identity.events

# ── OpenTelemetry (ADR-0004; exporter swappable) ────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=team-gateway
