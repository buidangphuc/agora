# team-notification environment configuration
ENV=local
LOG_LEVEL=info
LOG_JSON=true

GRPC_HOST=0.0.0.0
GRPC_PORT=50058
SHUTDOWN_GRACE_SECONDS=10
SHUTDOWN_DRAIN_DELAY_SECONDS=0

# DATABASE_URL is required. Outside ENV=local an unreachable database fails
# boot; in ENV=local the service starts anyway and database calls fail until it
# is reachable.
DATABASE_URL=postgres://notification_svc:notification_pass@localhost:5440/notification_db?sslmode=disable
DB_MAX_CONNS=10

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=team-notification

# Kafka consumers (one consumer group per topic). Kafka is always on.
KAFKA_BROKERS=localhost:19092
LISTING_EVENTS_TOPIC=listing.events
LISTING_EVENTS_DLQ_TOPIC=listing.events.dlq
NOTIFICATION_LISTING_CONSUMER_GROUP=team-notification.listing
CHAT_EVENTS_TOPIC=chat.events
CHAT_EVENTS_DLQ_TOPIC=chat.events.dlq
NOTIFICATION_CHAT_CONSUMER_GROUP=team-notification.chat
ORDER_EVENTS_TOPIC=order.events
ORDER_EVENTS_DLQ_TOPIC=order.events.dlq
NOTIFICATION_ORDER_CONSUMER_GROUP=team-notification.order

# Chat sender names: team-domain (shop display name) and team-identity (user display
# name). Called as a service principal (listing.read, identity.read); any failure
# falls back to a neutral label.
UPSTREAM_DOMAIN_ADDR=localhost:50051
UPSTREAM_IDENTITY_ADDR=localhost:50053
