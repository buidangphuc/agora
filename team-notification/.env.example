# team-notification environment configuration
ENV=local
LOG_LEVEL=info
LOG_JSON=true

GRPC_HOST=0.0.0.0
GRPC_PORT=50058
GRPC_REFLECTION_ENABLED=true
SHUTDOWN_GRACE_SECONDS=10

DATABASE_ENABLED=true
DATABASE_URL=postgres://notification_svc:notification_pass@localhost:5440/notification_db?sslmode=disable
DB_MAX_CONNS=10

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=team-notification
