# team-verification environment configuration
ENV=local
LOG_LEVEL=info
LOG_JSON=true

GRPC_HOST=0.0.0.0
GRPC_PORT=50064
GRPC_REFLECTION_ENABLED=true
SHUTDOWN_GRACE=10s
SHUTDOWN_DRAIN_DELAY=0s

DATABASE_URL=postgres://verification_svc:verification_pass@localhost:5444/verification_db?sslmode=disable
DB_MAX_CONNS=10

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=team-verification

# team-audit (KYC review audit, required in every environment)
UPSTREAM_AUDIT_ADDR=team-audit-svc:50066

MOCK_DATA=
