# team-verification environment configuration
ENV=local
LOG_LEVEL=info
LOG_JSON=true

GRPC_HOST=0.0.0.0
GRPC_PORT=50064
GRPC_REFLECTION_ENABLED=true

DATABASE_ENABLED=true
DATABASE_URL=postgres://verification_svc:verification_pass@localhost:5444/verification_db?sslmode=disable
DB_MAX_CONNS=10

# team-audit (KYC review audit, fail closed when unset or down)
UPSTREAM_AUDIT_ADDR=team-audit-svc:50066
UPSTREAM_CALL_TIMEOUT_SECONDS=2
