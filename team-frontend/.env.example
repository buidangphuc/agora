# Base URL of the platform Gateway (Connect). Frontend talks ONLY to the gateway.
GATEWAY_URL=http://localhost:8080
# Browser-visible Gateway URL for the tracking beacon (src/lib/track.ts). The
# beacon runs client-side, so it needs a NEXT_PUBLIC_* var; defaults to the
# gateway on localhost when unset.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
# Session token now comes from the httpOnly `session` cookie set at login (the
# gateway verifies it); there is no static bearer here.
OTEL_SERVICE_NAME=team-frontend
# Feature flags (OpenFeature + Flipt provider), evaluated SERVER-SIDE only — the
# browser never sees this. The JS provider uses Flipt's REST/HTTP API (port 8080);
# team-order (Go) uses the gRPC endpoint (:9000). Point this at the HTTP endpoint.
FLIPT_ADDR=flipt:8080
FEATURE_FLAGS_ENABLED=true
