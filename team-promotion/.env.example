# team-promotion environment configuration
ENV=local
LOG_LEVEL=info
LOG_JSON=true

GRPC_HOST=0.0.0.0
GRPC_PORT=50061
SHUTDOWN_GRACE_SECONDS=10
# Seconds to keep serving after health reports NOT_SERVING, so probes and load
# balancers notice before the server stops.
SHUTDOWN_DRAIN_DELAY_SECONDS=0

# Postgres is always on; an unreachable database fails boot outside ENV=local.
DATABASE_URL=postgres://promotion_svc:promotion_pass@localhost:5438/promotion_db?sslmode=disable
DB_MAX_CONNS=10

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=team-promotion

# Feature flags (OpenFeature + Flipt provider). FEATURE_FLAGS_ENABLED stays a
# real toggle: gitops runs promotion with it false. FLIPT_ADDR is the Flipt gRPC
# endpoint (flipt:9000 in compose, flipt.marketplace.svc:9000 in-cluster).
FEATURE_FLAGS_ENABLED=true
FLIPT_ADDR=localhost:9000
FEATURE_FLAGS_EVAL_TIMEOUT_MS=500

# Kafka — state-change events emitted on promotion.events (ADR-0002). Always on.
KAFKA_BROKERS=localhost:9092
PROMOTION_EVENTS_TOPIC=promotion.events

# team-domain gRPC address — used to verify a seller owns the listing in a
# flash-sale campaign. Unset = non-admin CreateCampaign fails closed.
UPSTREAM_DOMAIN_ADDR=localhost:50051

# Per-call timeout (seconds) for team-domain lookups. A dead upstream is then
# UNAVAILABLE rather than a gateway 504. Must be > 0.
UPSTREAM_CALL_TIMEOUT_SECONDS=2

# Upper bounds (minor units) for a sponsored ad campaign's bid and budget.
# CreateAdCampaign above either is INVALID_ARGUMENT. Must be > 0.
MAX_AD_BID=1000000
MAX_AD_BUDGET=1000000000
