ENV=local
LOG_LEVEL=info
LOG_JSON=true

GRPC_HOST=0.0.0.0
GRPC_PORT=50061
GRPC_REFLECTION_ENABLED=false
SHUTDOWN_GRACE=10s
SHUTDOWN_DRAIN_DELAY=0s

DATABASE_URL=postgres://promotion_svc:promotion_pass@localhost:5438/promotion_db?sslmode=disable
DB_MAX_CONNS=10

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=team-promotion

FLIPT_ADDR=localhost:9000
FEATURE_FLAGS_EVAL_TIMEOUT=500ms

KAFKA_BROKERS=localhost:9092
PROMOTION_EVENTS_TOPIC=promotion.events

OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100
OUTBOX_CLAIM_LOCK=60s

UPSTREAM_DOMAIN_ADDR=localhost:50051
UPSTREAM_AUDIT_ADDR=localhost:50066

MAX_AD_BID=1000000
MAX_AD_BUDGET=1000000000
