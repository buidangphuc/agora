# team-payment environment configuration. `make check-env` fails when this file drifts
# from the Settings struct in internal/config (both directions).
ENV=local
LOG_LEVEL=info
LOG_JSON=true

GRPC_HOST=0.0.0.0
GRPC_PORT=50056
SHUTDOWN_GRACE=10s
# Go duration to keep serving after health reports NOT_SERVING, so probes and load
# balancers notice before the server stops.
SHUTDOWN_DRAIN_DELAY=0s

DATABASE_URL=postgres://payment_svc:payment_pass@localhost:5438/payment_db?sslmode=disable
DB_MAX_CONNS=10

UPSTREAM_ORDER_ADDR=localhost:50055

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=team-payment

# Enables the ProcessMockPayment RPC (simulated settlement). Local/dev only: default false,
# and the service refuses to start with MOCK_PAYMENTS=true when ENV is staging/stage/prod/production.
MOCK_PAYMENTS=false

# Payout hold-back: settlement credits younger than the window cannot be paid out.
# PAYOUT_HOLD_DAYS is whole days, 0-3650 (0 disables). PAYOUT_HOLD_WINDOW, when set, is a
# Go duration (0 to 3650 days, e.g. 20s) that overrides it. Invalid values refuse startup.
PAYOUT_HOLD_DAYS=7
PAYOUT_HOLD_WINDOW=

# Kafka: the payment.events outbox relayer and the order.events settlement consumer.
KAFKA_BROKERS=localhost:9092
PAYMENT_EVENTS_TOPIC=payment.events
ORDER_EVENTS_TOPIC=order.events
PAYMENT_SETTLEMENT_CONSUMER_GROUP=team-payment.settlement
PAYMENT_SETTLEMENT_DLQ_TOPIC=order.events.payment-settlement.dlq

# Outbox relayer (payment_outbox_events). Transient publish errors retry with backoff and
# never park a row; only a record-level error does (see README, Outbox).
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100
OUTBOX_CLAIM_LOCK=60s
