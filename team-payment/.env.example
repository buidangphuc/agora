# team-payment environment configuration
ENV=local
LOG_LEVEL=info
LOG_JSON=true

GRPC_HOST=0.0.0.0
GRPC_PORT=50056
GRPC_REFLECTION_ENABLED=true
SHUTDOWN_GRACE_SECONDS=10

DATABASE_ENABLED=true
DATABASE_URL=postgres://payment_svc:payment_pass@localhost:5438/payment_db?sslmode=disable
DB_MAX_CONNS=10

UPSTREAM_ORDER_ADDR=localhost:50055

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=team-payment
