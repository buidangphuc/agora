GATEWAY_URL=http://localhost:8080
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
NEXT_PUBLIC_BUYER_APP_URL=http://localhost:3000
OTEL_SERVICE_NAME=team-frontend-seller
TRUSTED_PROXY_HOPS=1
# Forces the Secure attribute and the __Host- prefix on the seller_session and
# seller_refresh cookies. SERVER-ONLY (not NEXT_PUBLIC_*), read per request. Set it
# to true only in deployed TLS (https) environments; never on plain http, where
# browsers drop Secure cookies and login breaks.
# COOKIE_SECURE=true
