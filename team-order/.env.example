# team-order environment configuration
ENV=local
LOG_LEVEL=info
LOG_JSON=true

GRPC_HOST=0.0.0.0
GRPC_PORT=50055
GRPC_REFLECTION_ENABLED=true
SHUTDOWN_GRACE_SECONDS=10

DATABASE_ENABLED=true
DATABASE_URL=postgres://order_svc:order_pass@localhost:5437/order_db?sslmode=disable
DB_MAX_CONNS=10

UPSTREAM_DOMAIN_ADDR=localhost:50051
UPSTREAM_IDENTITY_ADDR=localhost:50053
UPSTREAM_PROMOTION_ADDR=

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=team-order

# Feature flags (OpenFeature + Flipt provider). FLIPT_ADDR is the Flipt gRPC
# endpoint (flipt:9000 in compose, flipt.marketplace.svc:9000 in-cluster).
FEATURE_FLAGS_ENABLED=true
FLIPT_ADDR=localhost:9000
FEATURE_FLAGS_EVAL_TIMEOUT_MS=500

# Kafka: consumes payment.events (PaymentSettled -> order PAID) and produces
# order.events (OrderPaidEvent with line items, ADR-0013) via the outbox relayer.
# KAFKA_ENABLED=false => no consumer and no relayer; outbox rows are still
# recorded with each PAID transition but not published.
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
ORDER_PAYMENT_CONSUMER_GROUP=team-order.payment
PAYMENT_EVENTS_TOPIC=payment.events
PAYMENT_EVENTS_DLQ_TOPIC=payment.events.dlq
ORDER_EVENTS_TOPIC=order.events

# Transactional outbox relayer (ADR-0002/0013; names match team-domain). Runs only
# when OUTBOX_ENABLED and KAFKA_ENABLED are both true.
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100
OUTBOX_CLAIM_LOCK_SECONDS=60
OUTBOX_MAX_ATTEMPTS=10

# Stock reservations (Go durations). RESERVATION_TTL is how long a checkout's stock
# hold (and an unfinished checkout attempt) lives before the sweep releases it;
# RESERVATION_SWEEP_INTERVAL is how often the sweep runs. An empty, invalid, zero
# or negative value falls back to the default (15m / 1m) with a warning; the
# service still starts. The e2e overlay shortens both.
RESERVATION_TTL=15m
RESERVATION_SWEEP_INTERVAL=1m
