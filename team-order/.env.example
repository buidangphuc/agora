# team-order environment configuration
ENV=local
LOG_LEVEL=info
LOG_JSON=true

GRPC_HOST=0.0.0.0
GRPC_PORT=50055
GRPC_REFLECTION_ENABLED=false
SHUTDOWN_GRACE=10s
SHUTDOWN_DRAIN_DELAY=0s

DATABASE_URL=postgres://order_svc:order_pass@localhost:5437/order_db?sslmode=disable
DB_MAX_CONNS=10

UPSTREAM_DOMAIN_ADDR=localhost:50051
UPSTREAM_IDENTITY_ADDR=localhost:50053
UPSTREAM_PROMOTION_ADDR=localhost:50061
UPSTREAM_AUDIT_ADDR=localhost:50066

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=team-order

# Feature flags (Flipt). FLIPT_ADDR is the Flipt gRPC
# endpoint (flipt:9000 in compose, flipt.marketplace.svc:9000 in-cluster).
FLIPT_ADDR=localhost:9000
FEATURE_FLAGS_EVAL_TIMEOUT=500ms

# Kafka: consumes payment.events (PaymentSettled -> order PAID) and produces
# order.events (OrderPaidEvent with line items, ADR-0013) via the outbox relayer.
KAFKA_BROKERS=localhost:9092
LOG_KEY_FP_SECRET=local-dev-log-key-fp-secret
ORDER_PAYMENT_CONSUMER_GROUP=team-order.payment
PAYMENT_EVENTS_TOPIC=payment.events
PAYMENT_EVENTS_DLQ_TOPIC=payment.events.dlq
ORDER_EVENTS_TOPIC=order.events

# Transactional outbox relayer (ADR-0002/0013; names match team-domain).
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100
OUTBOX_CLAIM_LOCK=60s

# Stock reservations (Go durations). RESERVATION_TTL is how long a checkout's stock
# hold (and an unfinished checkout attempt) lives before the sweep releases it;
# RESERVATION_SWEEP_INTERVAL is how often the sweep runs. An empty, invalid, zero
# or negative value falls back to the default (15m / 1m) with a warning; the
# service still starts. The e2e overlay shortens both.
RESERVATION_TTL=15m
RESERVATION_SWEEP_INTERVAL=1m

# Unpaid-order expiry (Go durations). PAYMENT_DEADLINE is how long an online-pay order
# may stay Pending; PAYMENT_REMINDER_BEFORE is how long before the deadline the
# reminder is emitted; LIFECYCLE_SWEEP_INTERVAL is how often the sweep runs. An
# empty, invalid, zero or negative value falls back to the default with a warning.
PAYMENT_DEADLINE=24h
PAYMENT_REMINDER_BEFORE=2h
LIFECYCLE_SWEEP_INTERVAL=1m

# Receipt and return durations (Go durations). Strict: a malformed, zero or
# negative value stops startup. AUTO_COMPLETE_AFTER is how long after shipped an
# order auto-completes; RETURN_WINDOW is how long after completion a return may
# be requested; RETURN_AUTO_APPROVE_AFTER is how long a return waits before it is
# auto-approved; SHIP_BY_AFTER is the seller's ship-by deadline after payment.
AUTO_COMPLETE_AFTER=168h
RETURN_WINDOW=360h
RETURN_AUTO_APPROVE_AFTER=72h
SHIP_BY_AFTER=48h

ENGAGEMENT_EVENTS_TOPIC=engagement.events
ORDER_DISPUTE_CONSUMER_GROUP=team-order.dispute
ENGAGEMENT_EVENTS_DLQ_TOPIC=engagement.events.order.dlq
