ENV=local
LOG_LEVEL=info
LOG_JSON=true

GRPC_HOST=0.0.0.0
GRPC_PORT=50054
GRPC_REFLECTION_ENABLED=false
SHUTDOWN_GRACE=10s
SHUTDOWN_DRAIN_DELAY=0s

DATABASE_URL=postgresql://engagement_svc:engagement_pass@localhost:5436/engagement_db
DB_MAX_CONNS=10

KAFKA_BROKERS=localhost:9092
LOG_KEY_FP_SECRET=local-dev-log-key-fp-secret

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=team-engagement

OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100
OUTBOX_CLAIM_LOCK=60s

KAFKA_CONSUMER_GROUP=team-engagement-feed
KAFKA_LISTING_TOPIC=listing.events
ENGAGEMENT_EVENTS_TOPIC=engagement.events

UPSTREAM_ORDER_ADDR=localhost:50055
UPSTREAM_AUDIT_ADDR=localhost:50066

REPORT_RETENTION_DAYS=730
REPORT_SWEEP_INTERVAL=24h
