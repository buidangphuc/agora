# Copy to .env. `make check-env` fails if this drifts from internal/config.
ENV=local
LOG_LEVEL=info
LOG_JSON=true

GRPC_HOST=0.0.0.0
GRPC_PORT=50054
GRPC_REFLECTION_ENABLED=true
SHUTDOWN_GRACE_SECONDS=10

# DB-per-service: ONLY team-engagement connects here (Rule 3).
DATABASE_ENABLED=true
DATABASE_URL=postgresql://engagement_svc:engagement_pass@localhost:5436/engagement_db
DB_MAX_CONNS=10

# Auth: reads the gateway-forwarded Principal (x-principal-*); no local secret.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=team-engagement

# Sibling services consulted over gRPC (Rule 3: their API, never their DB).
# Empty disables verified-purchase enrichment on reviews.
UPSTREAM_ORDER_ADDR=
# Per-call budget for upstream lookups (seconds); also capped by the request deadline.
UPSTREAM_CALL_TIMEOUT_SECONDS=2

# listing.events consumer: fills the follow-feed source (seller_listings). The
# group starts from the earliest offset, so a fresh deploy backfills the feed.
# Failed records retry, then park on <topic>.dlq. Off by default.
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=team-engagement-feed
KAFKA_LISTING_TOPIC=listing.events

# Engagement facts: the transactional outbox is relayed to this topic (needs
# KAFKA_ENABLED=true and KAFKA_BROKERS; rows wait in the outbox while Kafka is off).
ENGAGEMENT_EVENTS_TOPIC=engagement.events
ENGAGEMENT_OUTBOX_RELAY_INTERVAL=500ms
