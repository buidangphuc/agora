# Runtime
ENV=local
LOG_LEVEL=info
LOG_JSON=false

# gRPC
GRPC_HOST=0.0.0.0
GRPC_PORT=9090
# Reflection is always on. hello's hand-built ServiceDesc has no descriptor, so
# reflection cannot describe its methods; generated services can.
SHUTDOWN_GRACE_SECONDS=10
SHUTDOWN_DRAIN_DELAY_SECONDS=0

# Postgres (DATABASE_URL is required; ENV=local tolerates an unreachable database)
DATABASE_URL=postgres://hello:hello@localhost:5432/hello?sslmode=disable
DB_MAX_CONNS=10

# OpenTelemetry
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
