# Copy to .env and fill in. .env is gitignored; never commit real secrets.
#
# This file is the documented contract for configuration. `make check-env` fails
# if it drifts from the fields declared in internal/config (both directions):
# every Settings field must appear here, and no stale key may linger.

# ── Runtime ─────────────────────────────────────────────────────────────────
# Environment label. In a strict ENV (staging | stage | prod | production, case-
# insensitive) the service refuses to boot while STORAGE_ACCESS_KEY or
# STORAGE_SECRET_KEY is still the minioadmin default. local/test/dev are unaffected.
ENV=local
LOG_LEVEL=info
LOG_JSON=true

# ── gRPC server ─────────────────────────────────────────────────────────────
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
SHUTDOWN_GRACE_SECONDS=10
# Seconds to keep serving after health reports NOT_SERVING, so probes and load
# balancers notice before the server stops.
SHUTDOWN_DRAIN_DELAY_SECONDS=0

# ── Database (DB-per-service: ONLY this service connects here — Rule 3/ADR) ──
DATABASE_URL=postgresql://listing_svc:listing_pass@localhost:5433/listing_db
DB_MAX_CONNS=10

# ── Storage (S3 / MinIO object store for product media) ─────────────────────
STORAGE_ENDPOINT=localhost:9000
STORAGE_BUCKET=listing-images
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/listing-images

# Auth: no local secret here. Per ADR-0003 the Gateway verifies the JWT at the
# edge and forwards a resolved Principal (x-principal-*); this service just reads
# it. Enforcement is via RequireScopes in handlers.

# ── Events / Kafka producer (ADR-0002) ──────────────────────────────────────
# Every write (Create/Update listing) emits a ListingChanged event to Kafka.
KAFKA_BROKERS=localhost:9092
KAFKA_LISTING_TOPIC=listing.events

# ── Transactional outbox relayer (ADR-0002) ─────────────────────────────────
# Listing writes always record an outbox row in the SAME DB transaction as the
# write (no dual-write hazard). The relayer publishes those rows to Kafka; the
# publisher and the relayer are always on.
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100
OUTBOX_CLAIM_LOCK_SECONDS=60
OUTBOX_MAX_ATTEMPTS=10

# ── Stock reservations (spec inventory-reservations) ────────────────────────
# Go durations. A missing, unparsable or non-positive value falls back to the
# default shown here with a WARN log; it never stops the service from starting.
# RESERVATION_TTL: how long an uncommitted (active) reservation holds stock
# before the sweeper restores it. RESERVATION_SWEEP_INTERVAL: sweeper period.
# Committed reservations (placed orders) are never swept.
RESERVATION_TTL=15m
RESERVATION_SWEEP_INTERVAL=1m

# ── OpenTelemetry (ADR-0004; exporter swappable) ────────────────────────────
# OTEL_ENABLED=false keeps tracing to a no-op (no exporter dialed) for local dev.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=team-domain
