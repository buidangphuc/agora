# Copy to .env and fill in. .env is gitignored; never commit real secrets.
# The drift test fails if this file and internal/config Settings disagree.

# Required: local, test, staging or prod. No default.
ENV=local
LOG_LEVEL=info
LOG_JSON=true

GRPC_HOST=0.0.0.0
# Required.
GRPC_PORT=50051
SHUTDOWN_GRACE=10s
SHUTDOWN_DRAIN_DELAY=0s
# Only accepted when ENV is local or test.
GRPC_REFLECTION_ENABLED=false

# Required.
DATABASE_URL=postgresql://listing_svc:listing_pass@localhost:5433/listing_db
DB_MAX_CONNS=10

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=team-domain

# Required when ENV is staging or prod; localhost:9092 locally.
KAFKA_BROKERS=localhost:9092
KAFKA_LISTING_TOPIC=listing.events
KAFKA_IDENTITY_TOPIC=identity.events
KAFKA_IDENTITY_GROUP=team-domain-identity

OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100
OUTBOX_CLAIM_LOCK=60s

# Required when ENV is staging or prod; a local default is used otherwise.
LOG_KEY_FP_SECRET=local-dev-log-key-fp-secret

STORAGE_ENDPOINT=localhost:9000
STORAGE_BUCKET=listing-images
# Must not be minioadmin when ENV is staging or prod.
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/listing-images

# Go durations; an invalid value falls back to the default with a WARN.
RESERVATION_TTL=15m
RESERVATION_SWEEP_INTERVAL=1m

# Required in every ENV.
UPSTREAM_AUDIT_ADDR=localhost:50066
UPSTREAM_AI_ADDR=localhost:50051
UPSTREAM_AI_TIMEOUT_SECONDS=2

# Optional prohibited-terms file; unset uses the embedded list. A set but missing file stops start-up.
SCREEN_TERMS_FILE=
