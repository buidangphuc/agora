{
  "name": "fe-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": ["packages/*", "templates/*"],
  "scripts": {
    "lint": "biome check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "boundaries": "node scripts/check-boundaries.mjs",
    "disables": "node scripts/check-disables.mjs",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run boundaries && npm run disables && npm run tokens && npm run proto:check && npm run catalog:check && npm run test",
    "tokens": "node scripts/check-tokens.mjs",
    "proto:check": "node scripts/proto-check.mjs",
    "catalog": "node scripts/catalog.mjs",
    "catalog:check": "node scripts/catalog.mjs --check",
    "release:status": "changeset status --since=${BASE:-origin/main}",
    "release:version": "changeset version && npm install --package-lock-only",
    "release:publish": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.12.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": "^8.5.29"
  }
}
