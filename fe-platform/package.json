{
  "name": "fe-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": ["packages/*", "templates/*"],
  "scripts": {
    "lint": "biome check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "boundaries": "node scripts/check-boundaries.mjs",
    "disables": "node scripts/check-disables.mjs",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run boundaries && npm run disables && npm run tokens && npm run test",
    "tokens": "node scripts/check-tokens.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^22.12.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": "^8.5.29"
  }
}
