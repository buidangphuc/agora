{
  "components": [
    {
      "name": "Button",
      "kind": "component",
      "purpose": "Action trigger. One `primary` per view; `ghost` for low-emphasis actions; `danger` for destructive ones; `fullWidth=\"mobile\"` is full width below the sm breakpoint only.",
      "client": false,
      "platforms": [
        "web",
        "wap"
      ],
      "props": [
        {
          "name": "variant",
          "required": false,
          "type": "\"primary\" | \"secondary\" | \"ghost\" | \"danger\""
        },
        {
          "name": "size",
          "required": false,
          "type": "\"xs\" | \"sm\" | \"md\" | \"lg\""
        },
        {
          "name": "loading",
          "required": false,
          "type": "boolean"
        },
        {
          "name": "fullWidth",
          "required": false,
          "type": "boolean | \"mobile\""
        },
        {
          "name": "leftIcon",
          "required": false,
          "type": "ReactNode"
        },
        {
          "name": "rightIcon",
          "required": false,
          "type": "ReactNode"
        }
      ],
      "native": "button"
    },
    {
      "name": "Card",
      "kind": "component",
      "purpose": "Surface that groups related content such as a product, a summary or a form.",
      "client": false,
      "platforms": [
        "web",
        "wap"
      ],
      "props": [
        {
          "name": "padded",
          "required": false,
          "type": "boolean"
        },
        {
          "name": "hoverable",
          "required": false,
          "type": "boolean"
        },
        {
          "name": "loading",
          "required": false,
          "type": "boolean"
        }
      ],
      "native": "div"
    },
    {
      "name": "CardContent",
      "kind": "component",
      "purpose": "Padded body of a flush Card.",
      "client": false,
      "platforms": [
        "web",
        "wap"
      ],
      "props": [],
      "native": "div"
    },
    {
      "name": "CardDescription",
      "kind": "component",
      "purpose": "Supporting line under a CardTitle.",
      "client": false,
      "platforms": [
        "web",
        "wap"
      ],
      "props": [],
      "native": "p"
    },
    {
      "name": "CardFooter",
      "kind": "component",
      "purpose": "Muted bottom row of a flush Card for meta text or links.",
      "client": false,
      "platforms": [
        "web",
        "wap"
      ],
      "props": [],
      "native": "div"
    },
    {
      "name": "CardHeader",
      "kind": "component",
      "purpose": "Top row of a flush Card: title on the left, optional actions on the right.",
      "client": false,
      "platforms": [
        "web",
        "wap"
      ],
      "props": [],
      "native": "div"
    },
    {
      "name": "CardTitle",
      "kind": "component",
      "purpose": "Heading of a Card, rendered as an h3.",
      "client": false,
      "platforms": [
        "web",
        "wap"
      ],
      "props": [],
      "native": "h3"
    },
    {
      "name": "Checkbox",
      "kind": "component",
      "purpose": "Boolean choice with a label (visible unless `labelHidden`), optional mixed state and error text.",
      "client": true,
      "platforms": [
        "web",
        "wap"
      ],
      "props": [
        {
          "name": "label",
          "required": true,
          "type": "string"
        },
        {
          "name": "labelHidden",
          "required": false,
          "type": "boolean"
        },
        {
          "name": "id",
          "required": false,
          "type": "string"
        },
        {
          "name": "name",
          "required": false,
          "type": "string"
        },
        {
          "name": "checked",
          "required": false,
          "type": "boolean | \"indeterminate\""
        },
        {
          "name": "defaultChecked",
          "required": false,
          "type": "boolean"
        },
        {
          "name": "onCheckedChange",
          "required": false,
          "type": "(checked: boolean) => void"
        },
        {
          "name": "disabled",
          "required": false,
          "type": "boolean"
        },
        {
          "name": "errorText",
          "required": false,
          "type": "string"
        },
        {
          "name": "\"data-testid\"",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "Dialog",
      "kind": "component",
      "purpose": "Modal for a focused task or confirmation. Title and description are required.",
      "client": true,
      "platforms": [
        "web",
        "wap"
      ],
      "props": [
        {
          "name": "triggerLabel",
          "required": true,
          "type": "string"
        },
        {
          "name": "title",
          "required": true,
          "type": "string"
        },
        {
          "name": "description",
          "required": true,
          "type": "string"
        },
        {
          "name": "children",
          "required": false,
          "type": "ReactNode"
        },
        {
          "name": "open",
          "required": false,
          "type": "boolean"
        },
        {
          "name": "onOpenChange",
          "required": false,
          "type": "(open: boolean) => void"
        }
      ]
    },
    {
      "name": "Input",
      "kind": "component",
      "purpose": "Text field with a required visible label; `required` adds a hidden-from-AT mark. Errors are text, never colour alone.",
      "client": false,
      "platforms": [
        "web",
        "wap"
      ],
      "props": [
        {
          "name": "label",
          "required": true,
          "type": "string"
        },
        {
          "name": "errorText",
          "required": false,
          "type": "string"
        },
        {
          "name": "helpText",
          "required": false,
          "type": "string"
        }
      ],
      "native": "input"
    },
    {
      "name": "Link",
      "kind": "component",
      "purpose": "Navigation to another page. Use for every \"go there\" action; Button is for actions on the current page.",
      "client": false,
      "platforms": [
        "web",
        "wap"
      ],
      "props": [
        {
          "name": "href",
          "required": true,
          "type": "string"
        },
        {
          "name": "prefetch",
          "required": false,
          "type": "boolean"
        },
        {
          "name": "replace",
          "required": false,
          "type": "boolean"
        },
        {
          "name": "scroll",
          "required": false,
          "type": "boolean"
        }
      ],
      "native": "a"
    },
    {
      "name": "Select",
      "kind": "component",
      "purpose": "Single choice from a short list; use Input for free text.",
      "client": true,
      "platforms": [
        "web",
        "wap"
      ],
      "props": [
        {
          "name": "label",
          "required": true,
          "type": "string"
        },
        {
          "name": "options",
          "required": true,
          "type": "SelectOption[]"
        },
        {
          "name": "placeholder",
          "required": false,
          "type": "string"
        },
        {
          "name": "name",
          "required": false,
          "type": "string"
        },
        {
          "name": "value",
          "required": false,
          "type": "string"
        },
        {
          "name": "defaultValue",
          "required": false,
          "type": "string"
        },
        {
          "name": "onValueChange",
          "required": false,
          "type": "(value: string) => void"
        },
        {
          "name": "disabled",
          "required": false,
          "type": "boolean"
        },
        {
          "name": "errorText",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "Table",
      "kind": "component",
      "purpose": "Read-only data table with a required caption and column-scoped headers.",
      "client": false,
      "platforms": [
        "web",
        "wap"
      ],
      "props": [
        {
          "name": "caption",
          "required": true,
          "type": "string"
        },
        {
          "name": "columns",
          "required": true,
          "type": "TableColumn[]"
        },
        {
          "name": "rows",
          "required": true,
          "type": "Record<string, ReactNode>[]"
        },
        {
          "name": "emptyText",
          "required": false,
          "type": "string"
        }
      ]
    },
    {
      "name": "ToastProvider",
      "kind": "component",
      "purpose": "Wrap the app once; call `useToast().toast(...)` from any client component.",
      "client": true,
      "platforms": [
        "web",
        "wap"
      ],
      "props": [
        {
          "name": "children",
          "required": true,
          "type": "ReactNode"
        }
      ]
    },
    {
      "name": "useToast",
      "kind": "hook",
      "purpose": "Returns `toast(message)` for transient feedback; only valid under ToastProvider.",
      "client": true,
      "platforms": [
        "web",
        "wap"
      ],
      "props": []
    }
