ENV=local
LOG_LEVEL=info
LOG_JSON=true

GRPC_HOST=0.0.0.0
GRPC_PORT=50053
GRPC_REFLECTION_ENABLED=false
SHUTDOWN_GRACE=10s
SHUTDOWN_DRAIN_DELAY=0s

DATABASE_URL=postgresql://identity_svc:identity_pass@localhost:5435/identity_db
DB_MAX_CONNS=10

KAFKA_BROKERS=localhost:9092
LOG_KEY_FP_SECRET=local-dev-log-key-fp-secret
IDENTITY_EVENTS_TOPIC=identity.events

OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100
OUTBOX_CLAIM_LOCK=60s
OUTBOX_PURGE_RETENTION=168h
OUTBOX_PURGE_INTERVAL=1h

JWT_PRIVATE_KEY=dev-rsa-private-key-pem-change-me
JWT_KID=dev-2026
JWKS_HTTP_PORT=50063
JWT_TTL_SECONDS=3600

SEED_ADMIN_ENABLED=false
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

PASSWORD_RESET_EXPOSE_TOKEN=false

UPSTREAM_AUDIT_ADDR=localhost:50061

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=team-identity

SESSION_RETENTION=720h
LOGIN_HISTORY_RETENTION=4320h
SESSION_SWEEP_INTERVAL=1h
SESSION_SWEEP_BATCH_SIZE=500
