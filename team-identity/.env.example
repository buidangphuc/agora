# Copy to .env. `make check-env` fails if this drifts from internal/config.

ENV=local
LOG_LEVEL=info
LOG_JSON=true

GRPC_HOST=0.0.0.0
GRPC_PORT=50053
GRPC_REFLECTION_ENABLED=true
SHUTDOWN_GRACE_SECONDS=10

# DB-per-service: ONLY team-identity connects here (Rule 3).
DATABASE_ENABLED=true
DATABASE_URL=postgresql://identity_svc:identity_pass@localhost:5435/identity_db
DB_MAX_CONNS=10

# ── Events / Kafka producer (ADR-0002, ADR-0003 addendum) ────────────────────
# RevokeSession writes a SessionRevoked outbox row in the SAME DB transaction; the
# relayer publishes it to IDENTITY_EVENTS_TOPIC so the gateway can deny the
# revoked session's token. KAFKA_ENABLED=false => rows are recorded, never relayed.
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
IDENTITY_EVENTS_TOPIC=identity.events

# ── Transactional outbox relayer (same names as team-domain) ─────────────────
# Runs only when OUTBOX_ENABLED and KAFKA_ENABLED are both true.
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100
OUTBOX_CLAIM_LOCK_SECONDS=60
OUTBOX_MAX_ATTEMPTS=10

# RS256 signing material (ADR-0006). team-identity is the sole issuer: it signs
# with this RSA PRIVATE key and stamps JWT_KID in every token header. The edge
# (team-gateway) verifies with the matching PUBLIC key it fetches from the JWKS
# below — it never holds this private key. Generate with `openssl genrsa 2048`.
# In the container the PEM is provided as a single line with \n escapes, or via a
# secret file; keep the real key out of git outside local dev.
JWT_PRIVATE_KEY=dev-rsa-private-key-pem-change-me
JWT_KID=dev-2026
# Port of the small HTTP listener that serves GET /.well-known/jwks.json (public
# keys only; unauthenticated). identity is otherwise gRPC-only.
JWKS_HTTP_PORT=50063
JWT_TTL_SECONDS=3600

# First-admin seeding. OFF by default; no built-in password. When enabled,
# SEED_ADMIN_PASSWORD is required (>= 12 chars) or the service refuses to start.
# Never enable in deployed environments; the local compose stack sets a dev value.
SEED_ADMIN_ENABLED=false
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# RequestPasswordReset never returns the raw reset token unless this is true (no
# email/SMS delivery exists yet). Dev/e2e only: enabling it lets any caller of the
# RPC take over any account. The service refuses to start with it on when ENV=prod.
PASSWORD_RESET_EXPOSE_TOKEN=false

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=team-identity
