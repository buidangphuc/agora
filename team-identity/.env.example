# Copy to .env. `make check-env` fails if this drifts from internal/config.

ENV=local
LOG_LEVEL=info
LOG_JSON=true

GRPC_HOST=0.0.0.0
GRPC_PORT=50053
GRPC_REFLECTION_ENABLED=true
SHUTDOWN_GRACE_SECONDS=10

# DB-per-service: ONLY team-identity connects here (Rule 3).
DATABASE_ENABLED=true
DATABASE_URL=postgresql://identity_svc:identity_pass@localhost:5435/identity_db
DB_MAX_CONNS=10

# RS256 signing material (ADR-0006). team-identity is the sole issuer: it signs
# with this RSA PRIVATE key and stamps JWT_KID in every token header. The edge
# (team-gateway) verifies with the matching PUBLIC key it fetches from the JWKS
# below — it never holds this private key. Generate with `openssl genrsa 2048`.
# In the container the PEM is provided as a single line with \n escapes, or via a
# secret file; keep the real key out of git outside local dev.
JWT_PRIVATE_KEY=dev-rsa-private-key-pem-change-me
JWT_KID=dev-2026
# Port of the small HTTP listener that serves GET /.well-known/jwks.json (public
# keys only; unauthenticated). identity is otherwise gRPC-only.
JWKS_HTTP_PORT=50063
JWT_TTL_SECONDS=3600

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=team-identity
