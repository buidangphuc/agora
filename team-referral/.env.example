# team-referral environment configuration
ENV=local
LOG_LEVEL=info
LOG_JSON=true

GRPC_HOST=0.0.0.0
GRPC_PORT=50062
GRPC_REFLECTION_ENABLED=true
SHUTDOWN_GRACE=10s
SHUTDOWN_DRAIN_DELAY=0s

DATABASE_URL=postgres://referral_svc:referral_pass@localhost:5444/referral_db?sslmode=disable
DB_MAX_CONNS=10

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=team-referral

KAFKA_BROKERS=localhost:9092
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100
OUTBOX_CLAIM_LOCK=60s

REFERRAL_REWARD_XU=10000
REFERRAL_DAILY_CAP=5
REFERRAL_LIFETIME_CAP=50
REFERRAL_REDEEM_MAX_ACCOUNT_AGE=168h
REFERRAL_RELEASE_SWEEP_INTERVAL=1m
REFERRAL_CAP_TIMEZONE=Asia/Ho_Chi_Minh
IDENTITY_EVENTS_TOPIC=identity.events
ORDER_EVENTS_TOPIC=order.events
REFERRAL_EVENTS_TOPIC=referral.events
REFERRAL_IDENTITY_CONSUMER_GROUP=team-referral-identity
REFERRAL_ORDER_CONSUMER_GROUP=team-referral-order
REFERRAL_IDENTITY_DLQ_TOPIC=referral.identity.dlq
REFERRAL_ORDER_DLQ_TOPIC=referral.order.dlq
