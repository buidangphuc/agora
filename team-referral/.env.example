# team-referral environment configuration
ENV=local
LOG_LEVEL=info
LOG_JSON=true

GRPC_HOST=0.0.0.0
GRPC_PORT=50062
GRPC_REFLECTION_ENABLED=true
SHUTDOWN_GRACE_SECONDS=10

DATABASE_ENABLED=true
