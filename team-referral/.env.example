# team-referral environment configuration
ENV=local
LOG_LEVEL=info
LOG_JSON=true

GRPC_HOST=0.0.0.0
GRPC_PORT=50062
SHUTDOWN_GRACE=10s
SHUTDOWN_DRAIN_DELAY=0s

# DATABASE_URL is required. Outside ENV=local an unreachable database fails
# boot; in ENV=local the service falls back to an in-memory store.
DATABASE_URL=postgres://referral_svc:referral_pass@localhost:5444/referral_db?sslmode=disable
DB_MAX_CONNS=10

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=team-referral
