# ============================================================================
# MINIMAL CORE (defaults): app factory + bearer auth + health + docs only.
# Everything below the core section is an OPT-IN capability — flip its
# *_ENABLED flag to true (and provision its backing service) when you need it.
# Standard stack for a typical service: DATABASE, REDIS, QUEUE, TASKS,
# RATE_LIMIT set to true.
# ============================================================================

ENVIRONMENT=dev
PROJECT_NAME="AI Solution Engineering Platform"
VERSION=0.1.0
DESCRIPTION="Reusable FastAPI foundation for AI solution engineering"
API_V1_PREFIX=/api/v1

DATABASE_ENABLED=false
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres # pragma: allowlist secret
POSTGRES_DB=ai_platform
# Pool tuning. DB_POOL_SIZE = steady connections, DB_MAX_OVERFLOW = burst above pool.
# Recycle helps PgBouncer/closed-by-server idle timeouts.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DATABASE=0
REDIS_TIMEOUT_SECONDS=5

# MongoDB (optional platform capability). Disabled by default; the platform
# core runs on Postgres + Redis. Needs the `mongo` extra (uv sync --extra mongo).
MONGO_ENABLED=false
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=app
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

AUTH_BEARER_TOKEN=change-me-local-bearer-token # pragma: allowlist secret
AUTH_SUBJECT=local-user
AUTH_ROLES=
RATE_LIMIT_ENABLED=false
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REDIS_PREFIX=rate-limit
RATE_LIMIT_IP_ENABLED=true
RATE_LIMIT_IP_PER_MINUTE=600
RATE_LIMIT_PRINCIPAL_ENABLED=true
RATE_LIMIT_PRINCIPAL_PER_MINUTE=60
RATE_LIMIT_EXCLUDE_PATHS=/healthz,/readyz
IDEMPOTENCY_ENABLED=false
IDEMPOTENCY_BACKEND=postgres
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_IN_PROGRESS_TIMEOUT_SECONDS=60
IDEMPOTENCY_KEY_MAX_LENGTH=64
QUOTA_ENABLED=false
QUOTA_BACKEND=memory

LOG_LEVEL=INFO
LOG_JSON=false
LOG_ENQUEUE=false

# LangChain chat model target. Leave empty to use the local fake model.
# Examples: openai:gpt-4.1-mini, anthropic:claude-sonnet-4-5
CHAT_MODEL=
CHAT_FALLBACK_MODELS=
JUDGE_CHAT_MODEL=
RAG_ENABLED=false
RAG_BACKEND=memory
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_DEFAULT_TOP_K=5
RAG_EMBED_MODEL=
RAG_MOCK_EMBED_DIM=16
RAG_RETRIEVE_TIMEOUT_SECONDS=10.0
# Embedding backend (ML/LLM decoupling seam): mock | model_server
RAG_EMBED_BACKEND=mock
RAG_EMBED_SERVER_URL=
RAG_EMBED_SERVER_PATH=/embed
RAG_EMBED_DIM=384
RAG_EMBED_TIMEOUT_SECONDS=10.0
# Vector store (used when RAG_BACKEND=qdrant)
RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_COLLECTION=rag_documents
# listing.events -> RAG indexer: Kafka consumer (needs the `kafka` extra and RAG_ENABLED=true).
# Failed records retry, then park on <topic>.dlq.
LISTING_INDEXER_ENABLED=false
KAFKA_BROKERS=localhost:9092
LISTING_INDEXER_TOPIC=listing.events
LISTING_INDEXER_GROUP=team-ai-indexer
LISTING_INDEXER_MAX_ATTEMPTS=5
LISTING_INDEXER_BASE_BACKOFF_SECONDS=0.1
# Chat streaming backend for gRPC ChatService: mock | llm_router
CHAT_BACKEND=mock
# llm_router resilience: first-token timeout per attempt, total pre-chunk attempts,
# per-target breaker (consecutive 429/5xx/timeout/connection failures, cooldown
# before one half-open probe).
LLM_FIRST_TOKEN_TIMEOUT_SECONDS=8.0
LLM_MAX_ATTEMPTS=3
LLM_BREAKER_THRESHOLD=3
LLM_BREAKER_COOLDOWN_SECONDS=30.0
# System prompt: Langfuse prompt when enabled, else this, else a built-in default.
CHAT_SYSTEM_PROMPT=
# Session history kept per (principal, session_id): newest turns first, bounded.
CHAT_HISTORY_MAX_TURNS=10
CHAT_HISTORY_MAX_TOKENS=1500
CHAT_HISTORY_TTL_SECONDS=1800
# User text in logs/traces: redacted | off | full (full refused outside dev/local/test).
# Text sent to the model is always redacted.
LLM_TRACE_CONTENT=redacted
# Chat quota (one unit per reply, resource chat.reply), enforced when QUOTA_ENABLED.
QUOTA_CHAT_REPLIES_PER_WINDOW=200
QUOTA_CHAT_WINDOW_SECONDS=86400

# gRPC transport (platform-core contract server)
GRPC_ENABLED=false
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
GRPC_REFLECTION_ENABLED=true
GRPC_GRACE_SECONDS=10.0
# Opt-in per-principal throttle on StreamChat + ShoppingAssistant (RATE_LIMIT_* knobs).
GRPC_RATE_LIMIT_ENABLED=false
# gRPC static-bearer fallback (grpcurl locally). Refused outside dev/local/test.
GRPC_BEARER_FALLBACK_ENABLED=false
# Require ai:use on ShoppingAssistant/StreamChat; keep false until team-identity grants it.
AI_USE_SCOPE_REQUIRED=false

CACHE_ENABLED=false
CACHE_BACKEND=memory
CACHE_PREFIX=app
CACHE_DEFAULT_TTL_SECONDS=300

WEBHOOKS_ENABLED=false
WEBHOOK_SIGNING_SECRET=
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
WEBHOOK_TIMEOUT_SECONDS=10

OBJECTS_ENABLED=false
OBJECT_BACKEND=memory
OBJECT_PREFIX=app
OBJECT_S3_BUCKET=
OBJECT_S3_REGION=ap-southeast-1
OBJECT_S3_ENDPOINT_URL=

OUTBOX_ENABLED=false
OUTBOX_BACKEND=postgres

CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
TRUSTED_HOSTS=*
MAX_REQUEST_BODY_BYTES=10485760

SECURITY_HEADERS_ENABLED=false
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE_SECONDS=31536000

# GZip compression. Disable when reverse proxy (nginx/Cloudflare/ALB) already does gzip.
GZIP_ENABLED=false
GZIP_MIN_SIZE=1024
GZIP_COMPRESS_LEVEL=5

# Per-request timeout. Patterns in REQUEST_TIMEOUT_EXCLUDE_PATTERNS bypass it
# (e.g. SSE/streaming endpoints that intentionally hold the connection).
REQUEST_TIMEOUT_ENABLED=false
REQUEST_TIMEOUT_SECONDS=30
REQUEST_TIMEOUT_EXCLUDE_PATTERNS=/stream,/sse

# Track in-flight requests and wait up to GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS for
# them to finish on SIGTERM. Enable for k8s rolling deploys.
GRACEFUL_SHUTDOWN_ENABLED=false
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30

# Async task infrastructure.
# QUEUE_BACKEND: memory (default) | redis | sqs | rabbitmq
# TASK_STORE_BACKEND: memory (default) | postgres | redis
QUEUE_ENABLED=false
QUEUE_BACKEND=memory
QUEUE_NAME=completions
SQS_QUEUE_URL=""
SQS_REGION=ap-southeast-1
SQS_ENDPOINT_URL=""
SQS_VISIBILITY_TIMEOUT_SECONDS=0
RABBITMQ_URL=""

TASKS_ENABLED=false
TASK_STORE_BACKEND=memory
TASK_REDIS_PREFIX=tasks
TASK_TTL_SECONDS=86400
TASKS_LEASE_SECONDS=300
TASKS_DISPATCH_BACKEND=queue

WORKER_MAX_CONCURRENT=10
WORKER_MAX_ATTEMPTS=3
WORKER_POLL_INTERVAL_SECONDS=0.5
WORKER_RECEIVE_BATCH_SIZE=10
WORKER_RECEIVE_WAIT_SECONDS=1.0

# OpenAPI docs. Set false in prod to hide /docs, /redoc, and /openapi.json.
DOCS_ENABLED=true

# Deliberately on in the example — the only pre-flipped opt-in flag. It pairs
# with the local self-hosted Langfuse stack (`make docker-run-langfuse`) and the
# bootstrapped keys below. Code default is false (app/core/config/ai.py); set
# false in your .env if you don't run the local stack. The app boots without the
# `ai` extra, but AI entry points raise a clear error if this is true and
# langfuse isn't installed. Pinned by tests/unit/core/test_config.py — update
# the test if you change it.
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=lf_pk_local_ai_platform
LANGFUSE_SECRET_KEY=lf_sk_local_ai_platform # pragma: allowlist secret
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PROMPT_CACHE_TTL_SECONDS=60

# Recommendation serving (Recommend RPC). See README.
RECS_ENABLED=false
RECS_BACKEND=memory
RECS_QDRANT_URL=http://localhost:6333
RECS_QDRANT_COLLECTION=item_als_vectors
RECS_VECTOR_DIM=64
RECS_QDRANT_DISTANCE=Cosine
RECS_CANDIDATE_TOP_K=100
RECS_RESULT_TOP_K=10
RECS_CACHE_PREFIX=recs
RECS_CACHE_SCHEMA_VERSION=v1
RECS_CACHE_TTL_SECONDS=86400
RECS_RETRIEVE_TIMEOUT_MS=15
RECS_MODEL_VERSION=serving-fallback
# Online features (platform-featurestore's Redis). Empty = off.
RECS_FEATURESTORE_REDIS_URL=
# Nearline signals (platform-recsys nearline consumer): empty = off.
RECS_NEARLINE_REDIS_URL=
RECS_NEARLINE_PREFIX=recs:nearline
RECS_NEARLINE_MIN_IMPRESSIONS=1.0
RECS_NEARLINE_TIMEOUT_MS=20
