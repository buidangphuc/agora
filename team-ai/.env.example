# team-ai settings. gRPC, Redis, recommendations, the rate limit, the chat quota and
# taxonomy persistence are always on. Only four switches remain: CHAT_BACKEND,
# RAG_ENABLED, AI_USE_SCOPE_REQUIRED and DOCS_ENABLED. OpenTelemetry starts when
# OTEL_EXPORTER_OTLP_ENDPOINT is set, Langfuse when both its keys are set.

ENVIRONMENT=dev
PROJECT_NAME="AI Solution Engineering Platform"
VERSION=0.1.0
DESCRIPTION="Reusable FastAPI foundation for AI solution engineering"
API_V1_PREFIX=/api/v1

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DATABASE=0
REDIS_TIMEOUT_SECONDS=5

# API keys: comma-separated `subject:scope|scope:sha256hex-of-token` entries. Store
# only hashes (`python -m scripts.hash_api_key --generate`). Several entries may
# share a subject (overlap rotation); scopes are empty unless listed. The hash
# below is for the local-only token `change-me-local-bearer-token`.
AUTH_API_KEYS=local-user:admin:2a61522f4af871304802321c6a35fcf5d0aa49e2d9dc4aedf9cf1c7fdb78b906 # pragma: allowlist secret
# Per-principal rate limit (HTTP and gRPC), counted in Redis.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REDIS_PREFIX=rate-limit
RATE_LIMIT_PRINCIPAL_PER_MINUTE=60
# Chat reply quota counters (Redis key prefix); the limits are QUOTA_CHAT_* below.
QUOTA_REDIS_PREFIX=quota

LOG_LEVEL=INFO
LOG_JSON=false
LOG_ENQUEUE=false

# LangChain chat model target. Leave empty to use the local fake model.
# Examples: openai:gpt-4.1-mini, anthropic:claude-sonnet-4-5
CHAT_MODEL=
CHAT_FALLBACK_MODELS=
JUDGE_CHAT_MODEL=
# Bounded provider calls. LLM_MAX_RETRIES is the SDK's hidden retry budget.
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
# Overall deadline for one call across the fallback chain (>= LLM_TIMEOUT_SECONDS).
LLM_CHAIN_DEADLINE_SECONDS=90
LLM_BREAKER_FAILURE_THRESHOLD=3
LLM_BREAKER_COOLDOWN_SECONDS=30
# RAG on: Qdrant store, model_server embeddings and the Kafka listing indexer; the
# three URLs below (RAG_QDRANT_URL, RAG_EMBED_SERVER_URL, KAFKA_BROKERS) are required.
RAG_ENABLED=false
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_DEFAULT_TOP_K=5
RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_COLLECTION=rag_documents
RAG_EMBED_SERVER_URL=
RAG_EMBED_SERVER_PATH=/embed
RAG_EMBED_DIM=384
RAG_EMBED_TIMEOUT_SECONDS=10.0
RAG_RETRIEVE_TIMEOUT_SECONDS=10.0
ASSISTANT_RAG_MIN_SCORE=0.0
# listing.events -> RAG indexer (runs with RAG_ENABLED=true; needs the `kafka` extra)
KAFKA_BROKERS=localhost:9092
LISTING_INDEXER_TOPIC=listing.events
LISTING_INDEXER_GROUP=team-ai-indexer
LISTING_INDEXER_MAX_ATTEMPTS=5
LISTING_INDEXER_BASE_BACKOFF_SECONDS=0.1
# Tag taxonomy persistence (curated tags survive restarts), in a Redis database
# other than REDIS_DATABASE.
TAXONOMY_REDIS_DATABASE=5
TAXONOMY_REDIS_PREFIX=tagtax

# Recommendations (gRPC Recommend; always on, always from Qdrant; names and defaults
# match team-ai). The service reads what platform-recsys and platform-featurestore
# write; empty *_REDIS_URL turns that signal off.
RECS_QDRANT_URL=http://localhost:6333
RECS_QDRANT_COLLECTION=item_als_vectors
RECS_VECTOR_DIM=64
RECS_QDRANT_DISTANCE=Cosine
RECS_CANDIDATE_TOP_K=100
RECS_RESULT_TOP_K=10
RECS_CACHE_PREFIX=recs
RECS_CACHE_SCHEMA_VERSION=v1
RECS_RETRIEVE_TIMEOUT_MS=15
RECS_MODEL_VERSION=serving-fallback
RECS_FEATURESTORE_REDIS_URL=
RECS_NEARLINE_REDIS_URL=
RECS_NEARLINE_PREFIX=recs:nearline
RECS_NEARLINE_MIN_IMPRESSIONS=1.0
RECS_NEARLINE_TIMEOUT_MS=20

CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
TRUSTED_HOSTS=*
MAX_REQUEST_BODY_BYTES=10485760

# Per-request timeout (always on). Patterns in REQUEST_TIMEOUT_EXCLUDE_PATTERNS bypass it
# (e.g. SSE/streaming endpoints that intentionally hold the connection).
REQUEST_TIMEOUT_SECONDS=30
REQUEST_TIMEOUT_EXCLUDE_PATTERNS=/stream,/sse

# Per-check timeout for the /readyz dependency checks (redis);
# checks run concurrently, so the probe takes about this long at worst.
HEALTH_CHECK_TIMEOUT_SECONDS=2

# Server-sent events (POST /api/v1/completions/stream): heartbeat comment interval,
# time to the first chunk (504 JSON error) and max gap between chunks
# (event: error, code stream_timeout).
SSE_HEARTBEAT_SECONDS=15
STREAM_FIRST_TOKEN_TIMEOUT_SECONDS=30
STREAM_IDLE_TIMEOUT_SECONDS=30

# Wait up to GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS for in-flight requests to finish on
# SIGTERM; /readyz returns 503 while draining. The Dockerfile passes the same timeout to
# uvicorn (--timeout-graceful-shutdown), so keep the pod's
# terminationGracePeriodSeconds above 2x this value.
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30
# `python -m app.serve` (the Dockerfile CMD) marks /readyz 503 on SIGTERM and keeps
# the listener open this many seconds before shutting down, so load balancers see
# the 503 and stop routing. 0 disables. Host/port: SERVER_HOST / SERVER_PORT.
SHUTDOWN_READINESS_DELAY_SECONDS=5

# OpenAPI docs (/docs, /redoc, /openapi.json). Unset: on in dev/local/test, off
# otherwise.
DOCS_ENABLED=true

# Langfuse starts when both keys are set (the local stack from
# `make docker-run-langfuse` bootstraps `lf_pk_local_ai_platform` /
# `lf_sk_local_ai_platform`). Blank here so the example boots without it; AI entry
# points raise a clear error if the keys are set and langfuse isn't installed.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PROMPT_CACHE_TTL_SECONDS=60

# Chat (gRPC StreamChat). CHAT_BACKEND=mock echoes offline; llm_router streams
# from the LLM chain and needs the `ai` extra. A blank CHAT_SYSTEM_PROMPT uses
# the built-in prompt. llm_router replies are metered by the quota below.
CHAT_BACKEND=mock
CHAT_FIRST_TOKEN_TIMEOUT_SECONDS=8.0
CHAT_SYSTEM_PROMPT=""
CHAT_HISTORY_MAX_TURNS=10
CHAT_HISTORY_MAX_TOKENS=1500
CHAT_HISTORY_TTL_SECONDS=1800
QUOTA_CHAT_REPLIES_PER_WINDOW=200
QUOTA_CHAT_WINDOW_SECONDS=86400

# OpenTelemetry (starts when the endpoint is set; needs the `otel` extra:
# `uv sync --extra otel`). Exports traces and GenAI metrics over OTLP/HTTP.
# The endpoint is the base URL (no /v1/traces suffix).
OTEL_SERVICE_NAME=ai-platform
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLE_RATIO=1.0

# gRPC transport (platform-core contract; always served, with reflection and the
# per-principal rate limit; port 0 binds an ephemeral port). Env names match team-ai.
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
GRPC_GRACE_SECONDS=10.0
AI_USE_SCOPE_REQUIRED=false
