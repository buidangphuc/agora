          <mxGeometry x="430" y="90" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- Git desired state = CodeCommit (Gitea) -->
        <mxCell id="git" value="platform-gitops (Gitea)&#10;= CodeCommit / Git&#10;khai 'chạy image nào'" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codecommit;" vertex="1" parent="1">
