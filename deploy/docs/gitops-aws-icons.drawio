<mxfile host="app.diagrams.net" agent="platform-e2e" version="24.7.17">
  <diagram id="gitops-aws" name="GitOps (AWS icons)">
    <mxGraphModel dx="1300" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="CI/CD GitOps — service (icon AWS = đích thật · trong ngoặc = tool chạy local)" style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="900" height="24" as="geometry" />
        </mxCell>

        <!-- Dev -->
        <mxCell id="dev" value="Dev&#10;(git push)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.user;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- CI = CodePipeline (GitHub Actions / act) -->
        <mxCell id="ci" value="CI · GitHub Actions (act)&#10;≈ CodePipeline&#10;build image + test" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codepipeline;" vertex="1" parent="1">
          <mxGeometry x="230" y="220" width="78" height="78" as="geometry" />
