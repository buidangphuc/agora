<mxfile host="app.diagrams.net" agent="platform-e2e" version="24.7.17">
  <diagram id="gitops-simple" name="GitOps (simple)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="CI/CD GitOps — xài service gì &amp; nối ra sao" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="12" width="700" height="26" as="geometry" />
        </mxCell>

        <mxCell id="dev" value="👨‍💻 Dev&#10;viết code, git push" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="gha" value="⚙️ GitHub Actions&#10;(chạy local = act)&#10;build image + test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="260" y="195" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="reg" value="📦 Registry (kind)&#10;= ECR&#10;kho chứa image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="530" y="90" width="210" height="90" as="geometry" />
        </mxCell>

        <mxCell id="git" value="🗂️ Gitea: platform-gitops&#10;= Git (nguồn sự thật)&#10;ghi 'chạy image tag nào'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="530" y="300" width="210" height="90" as="geometry" />
        </mxCell>

        <mxCell id="argo" value="🚀 ArgoCD&#10;thấy Git đổi&#10;→ tự deploy (pull)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="300" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="k8s" value="☸️ Kubernetes (kind)&#10;= EKS&#10;chạy các service (pod)&#10;+ Postgres/Kafka/…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1080" y="190" width="230" height="120" as="geometry" />
        </mxCell>

        <mxCell id="ing" value="🌐 ingress-nginx&#10;= ALB (cổng vào)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1370" y="90" width="150" height="80" as="geometry" />
        </mxCell>

        <mxCell id="user" value="🙍 User&#10;mở web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1380" y="320" width="130" height="70" as="geometry" />
        </mxCell>

        <!-- edges -->
        <mxCell id="e1" value="git push" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=12;" edge="1" parent="1" source="dev" target="gha"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="đẩy image" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=12;" edge="1" parent="1" source="gha" target="reg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="ghi tag mới" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=12;" edge="1" parent="1" source="gha" target="git"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="ArgoCD xem Git" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=12;" edge="1" parent="1" source="git" target="argo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="deploy" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=12;" edge="1" parent="1" source="argo" target="k8s"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="kéo image" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;fontSize=12;" edge="1" parent="1" source="reg" target="k8s"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="expose" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=12;" edge="1" parent="1" source="k8s" target="ing"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="mở trình duyệt" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=12;" edge="1" parent="1" source="user" target="ing"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
