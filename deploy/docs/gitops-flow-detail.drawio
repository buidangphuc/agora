<mxfile host="app.diagrams.net" agent="platform-e2e" version="24.7.17">
  <diagram id="gitops-detail" name="GitOps Flow (detailed)">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="GitOps reconciliation — ArgoCD pulls the desired state (platform-gitops @ Gitea) and continuously converges the live cluster (kind = EKS)" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="20" y="8" width="1680" height="24" as="geometry" />
        </mxCell>

        <!-- ================= ZONES ================= -->
        <mxCell id="zSrc" value="A · Source side (write only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="50" width="300" height="470" as="geometry" />
        </mxCell>
        <mxCell id="zGit" value="B · Desired state — Gitea: platform-gitops (single source of truth)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D6B656;dashed=0;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="50" width="320" height="470" as="geometry" />
        </mxCell>
        <mxCell id="zArgo" value="C · ArgoCD (GitOps engine) — the reconcile loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EEFA;strokeColor=#9673A6;dashed=0;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="50" width="470" height="640" as="geometry" />
        </mxCell>
        <mxCell id="zLive" value="D · Live state — kind cluster (EKS) · ns marketplace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F7FF;strokeColor=#4D7EA8;dashed=0;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1200" y="50" width="500" height="640" as="geometry" />
        </mxCell>

        <!-- ================= A: SOURCE ================= -->
        <mxCell id="appRepo" value="App repo (team-* / platform-e2e)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ci" value="CI (GitHub Actions / act)&#10;buf · make check · build image · e2e gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="reg" value="Registry :5001 (ECR)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="80" y="240" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ciWrite" value="CI commits new image tag&#10;(yq → envs/local/values.yaml)&#10;— the ONLY write CI makes to deploy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="noPush" value="No kubectl / helm from CI — push CD is forbidden" style="text;html=1;fontSize=10;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="260" height="20" as="geometry" />
        </mxCell>

        <!-- ================= B: GITOPS REPO ================= -->
        <mxCell id="gitBranch" value="branch: main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="90" width="280" height="34" as="geometry" />
        </mxCell>
        <mxCell id="gValues" value="envs/local/values.yaml&#10;image tags per service  ⇐ CI writes here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="370" y="140" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="gApps" value="argocd/apps/*.yaml&#10;child Applications (app-of-apps)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="370" y="210" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="gCharts" value="charts/service/&#10;generic Helm chart (Deployment/Service/&#10;Ingress/NetworkPolicy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="370" y="280" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gRevert" value="Rollback = git revert (previous tag)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="370" y="400" width="280" height="40" as="geometry" />
        </mxCell>

        <!-- ================= C: ARGOCD ================= -->
        <mxCell id="repoSrv" value="argocd-repo-server&#10;git clone + helm template&#10;→ DESIRED manifests (rendered)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="720" y="90" width="430" height="66" as="geometry" />
        </mxCell>
        <mxCell id="rootApp" value="root Application (app-of-apps) → renders child Applications" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="720" y="170" width="430" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ctrl" value="application-controller — reconcile loop (poll ~3 min OR git webhook)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="224" width="430" height="46" as="geometry" />
        </mxCell>
        <mxCell id="diff" value="diff&#10;DESIRED vs LIVE&#10;OutOfSync?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="800" y="300" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="inSync" value="InSync → idle (wait next tick)" style="text;html=1;fontSize=11;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="720" y="330" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sync" value="SYNC&#10;apply manifests&#10;(sync waves)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="720" y="430" width="200" height="64" as="geometry" />
        </mxCell>
        <mxCell id="heal" value="SELF-HEAL&#10;revert manual drift on cluster" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="950" y="430" width="200" height="64" as="geometry" />
        </mxCell>
        <mxCell id="prune" value="PRUNE&#10;delete resources no longer in git" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="720" y="520" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hooks" value="hooks: PreSync → Sync → PostSync → (SyncFail)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="950" y="520" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="status" value="app status → Synced / Healthy / Progressing / Degraded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1">
          <mxGeometry x="720" y="610" width="430" height="46" as="geometry" />
        </mxCell>

        <!-- ================= D: LIVE CLUSTER ================= -->
        <mxCell id="k8s" value="Kubernetes API (live objects)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1230" y="90" width="440" height="40" as="geometry" />
        </mxCell>
        <mxCell id="deploy" value="Deployment → ReplicaSet → Pod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="1230" y="150" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="netobj" value="Service · Ingress (ALB)&#10;NetworkPolicy (FE→gw; svc→own DB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="1480" y="150" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="presyncJob" value="PreSync: DB migrate job" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="1230" y="240" width="230" height="44" as="geometry" />
        </mxCell>
        <mxCell id="postsyncJob" value="PostSync Job: platform-e2e smoke (via ingress) → pass / fail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1230" y="310" width="440" height="50" as="geometry" />
        </mxCell>
        <mxCell id="infra" value="Infra (not emulated): postgres×N (RDS) · redpanda (MSK) · opensearch · minio (S3) · redis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="1230" y="390" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="drift" value="manual change / crash&#10;= drift" style="shape=note;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1480" y="240" width="190" height="60" as="geometry" />
        </mxCell>

        <!-- ================= EDGES ================= -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="appRepo" target="ci"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2" value="push image" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="ci" target="reg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="ci" target="ciWrite"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a4" value="git commit tag" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="ciWrite" target="gValues"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="b1" value="git clone (pull)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="gitBranch" target="repoSrv"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;dashed=1;" edge="1" parent="1" source="gValues" target="gitBranch"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;dashed=1;" edge="1" parent="1" source="gApps" target="gitBranch"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;dashed=1;" edge="1" parent="1" source="gCharts" target="gitBranch"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="c1" value="render" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="repoSrv" target="rootApp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="rootApp" target="ctrl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="ctrl" target="diff"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c4" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="diff" target="inSync"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c4b" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="inSync" target="ctrl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c5" value="Yes → sync" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="diff" target="sync"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="sync" target="prune"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="sync" target="hooks"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="d1" value="apply desired" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="sync" target="k8s"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="d2" value="watch LIVE (compare)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;fontSize=10;" edge="1" parent="1" source="k8s" target="diff"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="d3" value="re-apply" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="heal" target="k8s"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="d4" value="delete" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="prune" target="k8s"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="d5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="k8s" target="deploy"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="d6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="k8s" target="netobj"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="d7" value="image pull" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;fontSize=10;" edge="1" parent="1" source="reg" target="deploy"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="d8" value="drift → self-heal" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;fontSize=10;" edge="1" parent="1" source="drift" target="heal"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="h1" value="run" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="hooks" target="postsyncJob"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="h2" value="fail ⇒ SyncFailed" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;fontSize=10;" edge="1" parent="1" source="postsyncJob" target="status"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="h3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="status" target="ctrl"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="r1" value="git revert → new desired → reconcile back" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;fontSize=10;strokeColor=#B85450;" edge="1" parent="1" source="gRevert" target="gitBranch"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
